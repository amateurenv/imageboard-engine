# пример reverse proxy - подставь свой домен и пути к сертификатам
server {
    listen 443 ssl http2;
    server_name example.org;

    ssl_certificate /etc/letsencrypt/live/example.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/example.org/privkey.pem;
    # это верхняя граница всего multipart запроса, policy приложения дополнительно проверяет файл
    client_max_body_size 21m;

    # подставь абсолютный production путь MEDIA_STORAGE_ROOT
    # этот URL нельзя открыть снаружи: FastAPI выдаёт его только через X-Accel-Redirect
    location ~ ^/_imageboard_media/(display|previews)/([1-9][0-9]*)\.webp$ {
        internal;
        alias /srv/imageboard-media/$1/$2.webp;
        autoindex off;
        default_type image/webp;
        add_header Content-Disposition "inline" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        limit_except GET HEAD { deny all; }
    }

    # любой другой внутренний путь, включая quarantine и originals, остаётся недоступным
    location /_imageboard_media/ {
        internal;
        autoindex off;
        return 404;
    }

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
