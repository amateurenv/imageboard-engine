# пример reverse proxy - подставь свой домен и пути к сертификатам
server {
    listen 443 ssl http2;
    server_name example.org;

    ssl_certificate /etc/letsencrypt/live/example.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/example.org/privkey.pem;
    # это верхняя граница всего multipart запроса, policy приложения дополнительно проверяет файл
    client_max_body_size 21m;

    # подставь абсолютный production путь MEDIA_STORAGE_ROOT
    # этот URL нельзя открыть снаружи: FastAPI выдаёт его только через X-Accel-Redirect
    location ~ ^/_imageboard_media/(display|previews)/([1-9][0-9]*)\.webp$ {
        internal;
        alias /srv/imageboard-media/$1/$2.webp;
        autoindex off;
        default_type image/webp;
        add_header Content-Disposition "inline" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        limit_except GET HEAD { deny all; }
    }

    # стикер лежит в display, отдельный location задаёт no-store для модерации
    location ~ ^/_imageboard_media/stickers/([1-9][0-9]*)\.webp$ {
        internal;
        alias /srv/imageboard-media/display/$1.webp;
        autoindex off;
        default_type image/webp;
        # nginx переносит content-disposition и cache-control из ответа с redirect
        add_header X-Content-Type-Options "nosniff" always;
        limit_except GET HEAD { deny all; }
    }

    # tgs хранится как gzip-файл, клиент сам распаковывает каноническую анимацию
    location ~ ^/_imageboard_media/stickers/([1-9][0-9]*)\.tgs$ {
        internal;
        alias /srv/imageboard-media/stickers/$1.tgs;
        autoindex off;
        types {}
        default_type application/x-tgsticker;
        add_header X-Content-Type-Options "nosniff" always;
        limit_except GET HEAD { deny all; }
    }

    location ~ ^/_imageboard_media/sticker-previews/([1-9][0-9]*)\.webp$ {
        internal;
        alias /srv/imageboard-media/previews/$1.webp;
        autoindex off;
        default_type image/webp;
        add_header X-Content-Type-Options "nosniff" always;
        limit_except GET HEAD { deny all; }
    }

    location ~ ^/_imageboard_media/stickers/([1-9][0-9]*)\.webm$ {
        # cache-control приходит от api после проверки видимости
        internal;
        alias /srv/imageboard-media/stickers/$1.webm;
        autoindex off;
        types {}
        default_type video/webm;
        max_ranges 1;
        add_header X-Content-Type-Options "nosniff" always;
        limit_except GET HEAD { deny all; }
    }

    # audio derivative также доступен только после FastAPI проверки opaque key
    location ~ ^/_imageboard_media/audio/([1-9][0-9]*)\.m4a$ {
        internal;
        alias /srv/imageboard-media/audio/$1.m4a;
        autoindex off;
        default_type audio/mp4;
        add_header Content-Disposition "inline" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header Accept-Ranges "bytes" always;
        limit_except GET HEAD { deny all; }
    }

    location ~ ^/_imageboard_media/voice/([1-9][0-9]*)\.ogg$ {
        internal;
        alias /srv/imageboard-media/voice/$1.ogg;
        autoindex off;
        default_type audio/ogg;
        add_header Content-Disposition "inline" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header Accept-Ranges "bytes" always;
        limit_except GET HEAD { deny all; }
    }

    location ~ ^/_imageboard_media/video/([1-9][0-9]*)\.mp4$ {
        internal;
        alias /srv/imageboard-media/video/$1.mp4;
        autoindex off;
        default_type video/mp4;
        # range обрабатывает static handler после проверки видимости в приложении
        max_ranges 1;
        add_header Content-Disposition "inline" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Cache-Control "no-store" always;
        limit_except GET HEAD { deny all; }
    }

    # отдельный маршрут оставляет то же правило кеша для видео и его превью
    location ~ ^/_imageboard_media/video-previews/([1-9][0-9]*)\.webp$ {
        internal;
        alias /srv/imageboard-media/previews/$1.webp;
        autoindex off;
        default_type image/webp;
        add_header Content-Disposition "inline" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Cache-Control "no-store" always;
        limit_except GET HEAD { deny all; }
    }

    # любой другой внутренний путь, включая quarantine и originals, остаётся недоступным
    location /_imageboard_media/ {
        internal;
        autoindex off;
        return 404;
    }

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
