# пример локальных настроек
# настоящие пароли и ключи сюда не добавлять
# имя приложения в /docs
APP_NAME=Imageboard Engine
# режим работы
APP_ENV=development
# подробные ошибки только на локальном компьютере
APP_DEBUG=true
# адрес postgresql, вместо change-me нужен локальный пароль
DATABASE_URL=postgresql://imageboard_app:change-me@localhost:5432/imageboard_dev
# адрес redis
REDIS_URL=redis://localhost:6379/0
