# Пример локального файла настроек. Настоящий .env не попадает в Git благодаря .gitignore.
# Здесь нельзя хранить настоящие пароли, ключи API или другие секреты.
# APP_NAME — название приложения, которое FastAPI покажет, например, в /docs.
APP_NAME=Imageboard Engine
# APP_ENV — режим работы; допустимые значения проверяются в app/core/config.py.
APP_ENV=development
# APP_DEBUG=true показывает подробные ошибки только на локальной машине.
# На публичном сервере всегда будет false.
APP_DEBUG=true
