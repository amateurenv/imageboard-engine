# шаблон локальных настроек - реальные секреты не добавлять
APP_NAME="Imageboard Engine"
APP_ENV="development"
APP_DEBUG="true"
TRUSTED_PROXY_IPS=""
DATABASE_URL="postgresql://imageboard_app:change-me@localhost:5432/imageboard_dev"
REDIS_URL="redis://localhost:6379/0"
MEDIA_STORAGE_ROOT="media"
MEDIA_STORAGE_MAX_BYTES=8589934592
MEDIA_STORAGE_MIN_FREE_BYTES=268435456
MEDIA_UPLOAD_MAX_FILE_BYTES=20971520
MEDIA_UPLOAD_CONCURRENCY=4
MEDIA_UPLOAD_TIMEOUT_SECONDS=120
FFMPEG_BIN="ffmpeg"
FFPROBE_BIN="ffprobe"
